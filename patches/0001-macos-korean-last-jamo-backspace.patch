+import AppKit
 @testable import Ghostty
 import Testing
 
@@ -41,4 +42,80 @@ struct SurfaceViewAppKitTests {
             ) == false
         )
     }
+
+    // MARK: Backspace on the last Hangul jamo (#14797)
+
+    @Test func dropsCommitWhenBackspaceDeletesTheLastJamo() {
+        #expect(
+            Ghostty.SurfaceView.isPreeditDeletionCommit(
+                ["\u{3147}"],
+                markedBefore: "\u{3147}",
+                key: .backspace,
+                mods: []
+            )
+        )
+    }
+
+    @Test func keepsCommitWhenTextDiffersFromThePreedit() {
+        // e.g. a new syllable started: the previous one is committed and
+        // must still reach the terminal.
+        #expect(
+            Ghostty.SurfaceView.isPreeditDeletionCommit(
+                ["\u{D55C}"],
+                markedBefore: "\u{3147}",
+                key: .backspace,
+                mods: []
+            ) == false
+        )
+    }
+
+    @Test(arguments: [
+        Ghostty.Input.Key.arrowLeft,
+        Ghostty.Input.Key.enter,
+        Ghostty.Input.Key.space,
+        Ghostty.Input.Key.delete,
+    ])
+    func keepsCommitForKeysOtherThanBackspace(key: Ghostty.Input.Key) {
+        #expect(
+            Ghostty.SurfaceView.isPreeditDeletionCommit(
+                ["\u{3147}"],
+                markedBefore: "\u{3147}",
+                key: key,
+                mods: []
+            ) == false
+        )
+    }
+
+    @Test func keepsCommitForModifiedBackspace() {
+        #expect(
+            Ghostty.SurfaceView.isPreeditDeletionCommit(
+                ["\u{3147}"],
+                markedBefore: "\u{3147}",
+                key: .backspace,
+                mods: [.option]
+            ) == false
+        )
+    }
+
+    @Test func keepsCommitWhenThereWasNoPreedit() {
+        #expect(
+            Ghostty.SurfaceView.isPreeditDeletionCommit(
+                [""],
+                markedBefore: "",
+                key: .backspace,
+                mods: []
+            ) == false
+        )
+    }
+
+    @Test func keepsCommitWhenKeyIsUnknown() {
+        #expect(
+            Ghostty.SurfaceView.isPreeditDeletionCommit(
+                ["\u{3147}"],
+                markedBefore: "\u{3147}",
+                key: nil,
+                mods: []
+            ) == false
+        )
+    }
 }
